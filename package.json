{
  "name": "clipaste",
  "productName": "Clipaste",
  "version": "2.0.0",
  "description": "A simple clipboard manager. It keeps your clipboard history and shows the app each item came from.",
  "type": "module",
  "main": "src/main/main.js",
  "homepage": "https://ahmetkorkmaz3.github.io/clipaste/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmetkorkmaz3/clipaste.git"
  },
  "bugs": {
    "url": "https://github.com/ahmetkorkmaz3/clipaste/issues"
  },
  "keywords": [
    "clipboard",
    "clipboard-manager",
    "clipboard-history",
    "copy",
    "paste",
    "electron",
    "snap"
  ],
  "author": "Ahmet Korkmaz <muratahmetkorkmaz@hotmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "lowdb": "^7.0.1",
    "x11": "^4.3.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": false
  },
  "build": {
    "appId": "com.arkkod.clipaste",
    "productName": "Clipaste",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "linux": {
      "target": [
        "snap",
        "deb",
        "AppImage"
      ],
      "executableName": "clipaste",
      "category": "Utility",
      "synopsis": "Clipboard manager",
      "maintainer": "Ahmet Korkmaz <muratahmetkorkmaz@hotmail.com>",
      "desktop": {
        "entry": {
          "StartupWMClass": "Clipaste",
          "Keywords": "clipboard;copy;paste;history;"
        }
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "snapcraft": {
      "base": "core24",
      "core24": {
        "useLXD": true,
        "grade": "stable",
        "confinement": "strict",
        "summary": "Clipboard manager that shows where each item came from",
        "autoStart": true
      }
    }
  }
}
